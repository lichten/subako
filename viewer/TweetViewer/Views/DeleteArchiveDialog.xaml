<Window x:Class="TweetViewer.Views.DeleteArchiveDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="削除の確認" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="ToolWindow">
    <!-- 見出し / 件数 / チェックボックス / 補足 / ボタンをそれぞれ別の行に置く。
         Grid.Row を省くと全て行 0 に重なって描画されるので必ず明示する。
         文言はチェック状態で長さが変わるため、高さは SizeToContent で内容に合わせる -->
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" x:Name="HeadlineText" TextWrapping="Wrap"
                   FontWeight="SemiBold" FontSize="14" />
        <TextBlock Grid.Row="1" x:Name="CountText" TextWrapping="Wrap"
                   Margin="0,8,0,0" Foreground="#666" />
        <CheckBox Grid.Row="2" x:Name="DeleteFilesBox" Margin="0,14,0,0"
                  Content="ツイートデータと画像も完全に削除する" />
        <TextBlock Grid.Row="3" x:Name="NoteText" TextWrapping="Wrap" Foreground="#666"
                   FontSize="12" Margin="0,8,0,0" />
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button Content="削除" Width="80" Click="Delete_Click" />
            <Button Content="キャンセル" Width="80" Margin="8,0,0,0"
                    IsDefault="True" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
