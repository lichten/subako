<Window x:Class="TweetViewer.Views.MediaViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:TweetViewer.Behaviors"
        Title="画像ビューア" Height="900" Width="1000"
        WindowStartupLocation="CenterOwner" Background="#1A1A1A"
        KeyDown="Window_KeyDown">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Image x:Name="MainImage" Stretch="Uniform" StretchDirection="DownOnly"
                   behaviors:ImagePathBehavior.DecodeWidth="0" />
            <Button Content="◀" Width="44" Height="80" HorizontalAlignment="Left"
                    VerticalAlignment="Center" Opacity="0.75" FontSize="18"
                    Click="Prev_Click" />
            <Button Content="▶" Width="44" Height="80" HorizontalAlignment="Right"
                    VerticalAlignment="Center" Opacity="0.75" FontSize="18"
                    Click="Next_Click" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock x:Name="BodyText" TextWrapping="Wrap" Foreground="#EEE"
                           FontSize="13" MaxHeight="80" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="MetaText" Foreground="#999" FontSize="12" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="ブラウザで開く" Padding="10,4" Click="OpenInBrowser_Click" />
                <Button Content="閉じる" Padding="10,4" Margin="8,0,0,0" IsCancel="True" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
