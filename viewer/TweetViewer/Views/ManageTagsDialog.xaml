<Window x:Class="TweetViewer.Views.ManageTagsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TweetViewer.ViewModels"
        Title="タグの整理" Height="320" Width="320"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ListBox x:Name="TagListBox" ItemsSource="{Binding Tags}"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:TagItemViewModel}">
                    <DockPanel Margin="2">
                        <TextBlock DockPanel.Dock="Right" Foreground="#666"
                                   Text="{Binding UserCount, StringFormat={}{0}人}" />
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,8,0,0">
            <Button Content="削除" Width="80" Click="Delete_Click" />
            <Button Content="閉じる" Width="80" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
