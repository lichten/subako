<Window x:Class="TweetViewer.Views.ImportFollowingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TweetViewer.Views"
        Title="フォロー中を一括登録" Height="520" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="ToolWindow">
    <!-- Grid.Row は必ず明示する (省略すると全て行 0 に重なって描画される) -->
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="フォロー元アカウント (@ なし):" />
        <TextBox Grid.Row="1" x:Name="SourceBox" Margin="0,6,0,0" FontSize="14"
                 VerticalContentAlignment="Center" />

        <TextBlock Grid.Row="2" Text="付けるタグ (複数選択できます):" Margin="0,12,0,0" />
        <ListBox Grid.Row="3" x:Name="TagListBox" Margin="0,6,0,0"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type views:TagCheckItem}">
                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                              Content="{Binding Name}" Margin="2" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="4" Text="新しいタグ (カンマ区切りで複数可):" Margin="0,12,0,0" />
        <TextBox Grid.Row="5" x:Name="NewTagsBox" Margin="0,6,0,0" FontSize="14"
                 VerticalContentAlignment="Center" />

        <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock Text="最大リクエスト数:" VerticalAlignment="Center" />
            <TextBox x:Name="MaxRequestsBox" Width="90" Margin="8,0,0,0" FontSize="14"
                     Text="50" VerticalContentAlignment="Center" />
        </StackPanel>

        <TextBlock Grid.Row="7" TextWrapping="Wrap" Foreground="#666" FontSize="12"
                   Margin="0,10,0,0"
                   Text="フォロー中のアカウントを 1 ページ 200 件で取得し、全員をユーザーとして登録して選んだタグを付けます。ツイートは取得しません — 登録後にタグで絞り込んでから「表示中をすべて更新...」を実行してください。既に登録済みのアカウントにも同じタグを付けます。" />

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button Content="開始" Width="80" IsDefault="True" Click="Ok_Click" />
            <Button Content="キャンセル" Width="80" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
