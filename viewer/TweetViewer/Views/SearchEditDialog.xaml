<Window x:Class="TweetViewer.Views.SearchEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="検索を編集" Height="340" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="ToolWindow">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel>
            <TextBlock Text="名称 (任意):" VerticalAlignment="Center" />
            <TextBox x:Name="NameBox" Margin="8,0,0,0" FontSize="14"
                     VerticalContentAlignment="Center"
                     ToolTip="サイドバーに表示する名前。空欄ならクエリを表示します" />
        </DockPanel>

        <TextBlock Grid.Row="1" Text="検索クエリ:" Margin="0,10,0,0" />
        <TextBox x:Name="QueryBox" Grid.Row="2" Margin="0,6,0,0" FontSize="14"
                 VerticalContentAlignment="Center" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock Text="RT数 ≥" VerticalAlignment="Center" />
            <TextBox x:Name="MinRetweetsBox" Width="70" Margin="6,0,0,0" FontSize="14"
                     VerticalContentAlignment="Center" />
            <TextBlock Text="いいね数 ≥" VerticalAlignment="Center" Margin="16,0,0,0" />
            <TextBox x:Name="MinFavesBox" Width="70" Margin="6,0,0,0" FontSize="14"
                     VerticalContentAlignment="Center" />
            <TextBlock Text="(空欄 = 制限なし)" VerticalAlignment="Center" Margin="12,0,0,0"
                       Foreground="#666" FontSize="12" />
        </StackPanel>

        <TextBlock Grid.Row="4" TextWrapping="Wrap" Foreground="#666" FontSize="12"
                   Margin="0,10,0,0">
            クエリや下限を変更しても取得済みツイートは残ります。取得の進捗
            (再開位置・バックフィル済み期間) はリセットされ、次回の
            更新/バックフィルから新しい条件で取得します。
        </TextBlock>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right"
                    VerticalAlignment="Bottom">
            <Button Content="保存" Width="80" IsDefault="True" Click="Ok_Click" />
            <Button Content="キャンセル" Width="80" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
