<Window x:Class="TweetViewer.Views.UpdateLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TweetViewer.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:FetchDialogViewModel}"
        Title="{Binding Username, StringFormat=更新: @{0}}" Height="420" Width="680"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ListBox ItemsSource="{Binding LogLines}" FontFamily="Consolas" FontSize="12"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 x:Name="LogList" />
        <DockPanel Grid.Row="1" Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Content="中断" Width="80"
                    Command="{Binding CancelCommand}"
                    IsEnabled="{Binding IsRunning}" />
            <ProgressBar DockPanel.Dock="Right" Width="120" Height="14" Margin="0,0,8,0"
                         IsIndeterminate="{Binding IsRunning}"
                         Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="{Binding ResultText}" VerticalAlignment="Center" FontWeight="SemiBold" />
        </DockPanel>
    </Grid>
</Window>
