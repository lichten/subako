<?xml version="1.0" encoding="utf-8"?>
<!-- 配布用の publish 設定 (docs/release-plan.md §4-1)。
     使い方: dotnet publish viewer/TweetViewer/TweetViewer.csproj -c Release -p:PublishProfile=win-x64
     self-contained + 単一 exe にして、利用者に .NET Runtime のインストールを求めない。
     fetcher 一式の同梱は csproj の BundleFetcherAndNotices ターゲットが行う -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>bin\publish\win-x64\</PublishDir>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- e_sqlite3 などのネイティブ DLL も exe に取り込む (runtimes\ フォルダを撒かない) -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- pdb を配布物に含めない -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
</Project>
