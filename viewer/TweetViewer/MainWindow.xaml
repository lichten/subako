<Window x:Class="TweetViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
        xmlns:behaviors="clr-namespace:TweetViewer.Behaviors"
        xmlns:vm="clr-namespace:TweetViewer.ViewModels"
        Title="Tweet Viewer" Height="800" Width="1100"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">
    <Window.Resources>
        <!-- ツイート行の右クリックメニュー。Style Setter 内に直接書くと Click ハンドラの
             接続 ID がずれて起動時に InvalidCastException になるためリソースに置く -->
        <ContextMenu x:Key="TweetContextMenu">
            <MenuItem Header="ブラウザで開く"
                      Command="{Binding OpenInBrowserCommand}" />
            <MenuItem Header="{Binding AddAuthorMenuHeader}"
                      IsEnabled="{Binding CanAddAuthor}"
                      Click="MenuAddAuthor_Click" />
            <Separator />
            <MenuItem Header="既読/未読を切り替え"
                      Command="{Binding ToggleReadCommand}" />
        </ContextMenu>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <!-- MinWidth: これより狭いとユーザー行の Auto 列 (アイコン/バッジ/更新ボタン) に
                 押されて名前が潰れる。GridSplitter が両側の Min/MaxWidth を尊重する -->
            <ColumnDefinition x:Name="SidebarColumn" Width="260" MinWidth="180" MaxWidth="600" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="320" />
        </Grid.ColumnDefinitions>

        <!-- サイドバー: ユーザー一覧 -->
        <DockPanel Grid.Row="0" Grid.Column="0" Background="#F4F4F6">
            <DockPanel DockPanel.Dock="Top" Margin="8">
                <Button DockPanel.Dock="Right" Content="＋" Width="28" Height="28"
                        ToolTip="ユーザーを追加" Click="AddUser_Click" />
                <Button DockPanel.Dock="Right" Content="⇩" Width="28" Height="28" Margin="0,0,4,0"
                        Click="ImportFollowings_Click"
                        IsEnabled="{Binding IsFetching, Converter={StaticResource InverseBool}}"
                        ToolTip="指定アカウントがフォロー中のアカウントをまとめて登録します(ツイートは取得しません)" />
                <TextBlock Text="ユーザー" FontWeight="Bold" VerticalAlignment="Center" />
            </DockPanel>
            <!-- タグフィルタ (未選択 = 全件表示。先頭の「(タグなし)」は疑似タグ) -->
            <DockPanel DockPanel.Dock="Top" Margin="8,0,8,4">
                <Button DockPanel.Dock="Right" Content="×" Width="22" Height="22" Margin="4,0,0,0"
                        ToolTip="タグフィルタを解除" Click="ClearTagFilter_Click" />
                <ComboBox ItemsSource="{Binding TagFilterOptions}"
                          SelectedItem="{Binding SelectedTagFilter}"
                          DisplayMemberPath="Name"
                          ToolTip="タグで絞り込みます。「(タグなし)」はタグが設定されていない項目だけを表示します" />
            </DockPanel>
            <!-- 上のタグフィルタで絞り込んだ結果に対して一括更新する -->
            <Button DockPanel.Dock="Top" Margin="8,0,8,6" Padding="4,2"
                    Content="表示中をすべて更新..." Click="UpdateAllVisible_Click"
                    IsEnabled="{Binding IsFetching, Converter={StaticResource InverseBool}}"
                    ToolTip="サイドバーに表示中のユーザーと検索を上から順に差分更新します(合計リクエスト数の上限を指定)" />
            <!-- 統合タイムライン (SelectedUser / SelectedSearch と相互排他の第 3 の選択状態) -->
            <ToggleButton DockPanel.Dock="Top" Margin="8,0,8,6" Padding="4,3"
                          IsChecked="{Binding IsAllTimeline}"
                          Content="統合タイムライン (すべて)"
                          ToolTip="サイドバーに表示中のユーザーと検索をすべて混ぜた時系列表示" />
            <!-- 検索セクション (保存済み API 検索) -->
            <DockPanel DockPanel.Dock="Bottom" MaxHeight="220">
                <DockPanel DockPanel.Dock="Top" Margin="8,4">
                    <Button DockPanel.Dock="Right" Content="＋" Width="28" Height="28"
                            ToolTip="X 全体をキーワード検索して保存" Click="AddSearch_Click" />
                    <TextBlock Text="検索" FontWeight="Bold" VerticalAlignment="Center" />
                </DockPanel>
                <ListBox ItemsSource="{Binding SearchesView}"
                         SelectedItem="{Binding SelectedSearch}"
                         BorderThickness="0" Background="Transparent"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SearchItemViewModel}">
                            <Grid Margin="4,4" Background="Transparent">
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="更新 (差分取得)..." Click="MenuSearchUpdate_Click" />
                                        <MenuItem Header="過去期間を取得 (バックフィル)..." Click="MenuSearchBackfill_Click" />
                                        <MenuItem Header="不足画像を取得 (API 不使用)" Click="MenuFetchImages_Click" />
                                        <Separator />
                                        <MenuItem Header="タグ" SubmenuOpened="TagMenu_SubmenuOpened">
                                            <!-- 子が空だと SubmenuOpened が発火しないためのプレースホルダ -->
                                            <MenuItem Header="(読込中)" />
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="編集 (名称・クエリ)..." Click="MenuSearchEdit_Click" />
                                        <MenuItem Header="削除..." Click="MenuSearchDelete_Click" />
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🔍" Margin="0,0,6,0"
                                           VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" ToolTip="{Binding Query}">
                                    <emoji:TextBlock Text="{Binding Label}" FontWeight="SemiBold"
                                                     FontSize="12" TextTrimming="CharacterEllipsis" />
                                    <TextBlock FontSize="11" Foreground="#666"
                                               Text="{Binding TweetCount, StringFormat={}{0:N0}件}" />
                                    <ItemsControl ItemsSource="{Binding Tags}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:TagItemViewModel}">
                                                <Border Background="#E1E8ED" CornerRadius="7" Padding="5,1" Margin="0,2,4,0">
                                                    <TextBlock Text="{Binding Name}" FontSize="10" Foreground="#555" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <Border Grid.Column="2" Background="#1D9BF0" CornerRadius="9"
                                        MinWidth="18" Height="18" Margin="4,0" Padding="5,0"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding HasUnread, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding UnreadCount}" Foreground="White"
                                               FontSize="11" VerticalAlignment="Center"
                                               HorizontalAlignment="Center" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            <ListBox ItemsSource="{Binding UsersView}"
                     SelectedItem="{Binding SelectedUser}"
                     BorderThickness="0" Background="Transparent"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:UserItemViewModel}">
                        <Grid Margin="4,6" Background="Transparent">
                            <Grid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="更新 (差分取得)" Click="MenuUpdate_Click" />
                                    <MenuItem Header="全期間を取得 (バックフィル)..." Click="MenuBackfill_Click" />
                                    <MenuItem Header="不足画像を取得 (API 不使用)" Click="MenuFetchImages_Click" />
                                    <Separator />
                                    <MenuItem Header="タグ" SubmenuOpened="TagMenu_SubmenuOpened">
                                        <!-- 子が空だと SubmenuOpened が発火しないためのプレースホルダ -->
                                        <MenuItem Header="(読込中)" />
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="削除..." Click="MenuUserDelete_Click" />
                                </ContextMenu>
                            </Grid.ContextMenu>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Width="32" Height="32" Margin="0,0,8,0"
                                  VerticalAlignment="Center">
                                <Ellipse Fill="#D0D7DC" />
                                <Image behaviors:ImagePathBehavior.Path="{Binding IconPath}"
                                       behaviors:ImagePathBehavior.DecodeWidth="64"
                                       Stretch="UniformToFill">
                                    <Image.Clip>
                                        <EllipseGeometry Center="16,16" RadiusX="16" RadiusY="16" />
                                    </Image.Clip>
                                </Image>
                            </Grid>
                            <StackPanel Grid.Column="1">
                                <emoji:TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                 TextTrimming="CharacterEllipsis" />
                                <TextBlock FontSize="11" Foreground="#666">
                                    <Run Text="@" /><Run Text="{Binding Username, Mode=OneWay}" />
                                    <Run Text=" " /><Run Text="{Binding TweetCount, Mode=OneWay, StringFormat={}{0:N0}件}" />
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding Tags}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:TagItemViewModel}">
                                            <Border Background="#E1E8ED" CornerRadius="7" Padding="5,1" Margin="0,2,4,0">
                                                <TextBlock Text="{Binding Name}" FontSize="10" Foreground="#555" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <Border Grid.Column="2" Background="#1D9BF0" CornerRadius="9"
                                    MinWidth="18" Height="18" Margin="4,0" Padding="5,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding HasUnread, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding UnreadCount}" Foreground="White"
                                           FontSize="11" VerticalAlignment="Center"
                                           HorizontalAlignment="Center" />
                            </Border>
                            <Button Grid.Column="3" Content="更新" Padding="6,2" Margin="2,0"
                                    VerticalAlignment="Center" Tag="{Binding}"
                                    Click="UpdateUser_Click"
                                    IsEnabled="{Binding DataContext.IsFetching,
                                        RelativeSource={RelativeSource AncestorType=Window},
                                        Converter={StaticResource InverseBool}}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- サイドバー幅のドラッグ変更 -->
        <GridSplitter Grid.Row="0" Grid.Column="1" Width="5"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Background="#E1E8ED" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                      ToolTip="ドラッグしてサイドバーの幅を変更" />

        <!-- コンテンツ: ツールバー + ツイートリスト -->
        <DockPanel Grid.Row="0" Grid.Column="2">
            <ToolBarTray DockPanel.Dock="Top">
                <ToolBar>
                    <RadioButton Content="タイムライン" GroupName="ViewMode" Padding="8,2"
                                 IsChecked="{Binding IsMediaView, Converter={StaticResource InverseBool}}" />
                    <RadioButton Content="メディア" GroupName="ViewMode" Padding="8,2"
                                 IsChecked="{Binding IsMediaView}" />
                    <Separator />
                    <ToggleButton IsChecked="{Binding UnreadOnly}" Content="未読のみ" Padding="8,2"
                                  IsEnabled="{Binding IsMediaView, Converter={StaticResource InverseBool}}" />
                    <Separator />
                    <Button Content="インデックス再構築" Command="{Binding RebuildCommand}" Padding="8,2"
                            ToolTip="選択中ユーザーの tweets インデックスを JSONL から作り直します(既読状態は保持)" />
                    <Separator />
                    <Button Content="設定" Padding="8,2" Click="Settings_Click"
                            ToolTip="データフォルダの場所や Python パスを変更します" />
                </ToolBar>
            </ToolBarTray>

            <Grid>
            <ListBox x:Name="TweetList"
                     ItemsSource="{Binding Items}"
                     Visibility="{Binding DataContext.IsMediaView,
                         RelativeSource={RelativeSource AncestorType=Window},
                         Converter={StaticResource InverseBoolToVis}}"
                     BorderThickness="0"
                     HorizontalContentAlignment="Stretch"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     VirtualizingPanel.CacheLengthUnit="Page"
                     VirtualizingPanel.CacheLength="1,2"
                     ScrollViewer.CanContentScroll="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     DataContext="{Binding TweetList}">
                <b:Interaction.Behaviors>
                    <behaviors:ScrollToTopOnResetBehavior />
                    <behaviors:ScrollReadBehavior />
                    <behaviors:InfiniteScrollBehavior LoadMoreCommand="{Binding LoadMoreCommand}" />
                </b:Interaction.Behaviors>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="ContextMenu" Value="{StaticResource TweetContextMenu}" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:TweetItemViewModel}">
                        <Border BorderBrush="#E1E8ED" BorderThickness="0,0,0,1" Padding="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!-- 未読アクセントバー -->
                                <Border x:Name="UnreadBar" Grid.Column="0" Width="3" Background="#1D9BF0" />
                                <!-- ユーザーアイコン (RT は RT元作者) -->
                                <Grid Grid.Column="1" Width="40" Height="40" Margin="10,10,0,0"
                                      VerticalAlignment="Top">
                                    <Ellipse Fill="#D0D7DC" />
                                    <Image behaviors:ImagePathBehavior.Path="{Binding MainIconPath}"
                                           behaviors:ImagePathBehavior.DecodeWidth="96"
                                           Stretch="UniformToFill">
                                        <Image.Clip>
                                            <EllipseGeometry Center="20,20" RadiusX="20" RadiusY="20" />
                                        </Image.Clip>
                                    </Image>
                                </Grid>
                                <StackPanel Grid.Column="2" Margin="10,8,12,8">
                                    <!-- RT ヘッダ (○○さんがリツイート) -->
                                    <emoji:TextBlock Text="{Binding RtHeader}" Foreground="#00BA7C" FontSize="12"
                                                     Margin="0,0,0,2"
                                                     Visibility="{Binding IsRetweet, Converter={StaticResource BoolToVis}}" />

                                    <!-- ヘッダ行 (RT は RT元作者) -->
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding CreatedAtLocal}"
                                                   Foreground="#666" FontSize="12" VerticalAlignment="Center" />
                                        <StackPanel Orientation="Horizontal">
                                            <emoji:TextBlock Text="{Binding HeaderDisplayName}" FontSize="13"
                                                             FontWeight="Bold" VerticalAlignment="Center" />
                                            <TextBlock FontSize="13" Foreground="#666" Margin="6,0,0,0"
                                                       VerticalAlignment="Center">
                                                <Run Text="@" /><Run Text="{Binding HeaderUsername, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>

                                    <!-- 返信ヘッダ -->
                                    <emoji:TextBlock Text="{Binding ReplyHeader}" Foreground="#1D9BF0" FontSize="12"
                                                     Margin="0,2,0,0"
                                                     Visibility="{Binding IsReply, Converter={StaticResource BoolToVis}}" />

                                    <!-- 本文 (URL リンク化 + カラー絵文字) -->
                                    <TextBlock behaviors:LinkifiedTextBehavior.Text="{Binding DisplayText}"
                                               TextWrapping="Wrap" Margin="0,4,0,0" FontSize="14" />

                                    <!-- 画像 -->
                                    <ItemsControl ItemsSource="{Binding ImagePaths}" Margin="0,6,0,0"
                                                  Visibility="{Binding HasImages, Converter={StaticResource BoolToVis}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="8" Margin="0,0,6,6" MaxHeight="280"
                                                        MaxWidth="400" Background="#F0F0F0">
                                                    <Image behaviors:ImagePathBehavior.Path="{Binding}"
                                                           Stretch="Uniform" StretchDirection="DownOnly" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- 動画リンクのサムネイル (YouTube / ニコニコ動画) -->
                                    <ItemsControl ItemsSource="{Binding LinkThumbnails}" Margin="0,6,0,0"
                                                  Visibility="{Binding HasLinkThumbnails, Converter={StaticResource BoolToVis}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:LinkThumbnailViewModel}">
                                                <Border CornerRadius="8" Margin="0,0,6,6" MaxHeight="180"
                                                        MaxWidth="320" Background="#F0F0F0" Cursor="Hand"
                                                        ToolTip="{Binding PageUrl}"
                                                        MouseLeftButtonUp="LinkThumbnail_Click"
                                                        Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}">
                                                    <Image behaviors:ImagePathBehavior.Path="{Binding ThumbnailPath}"
                                                           behaviors:ImagePathBehavior.DecodeWidth="320"
                                                           Stretch="Uniform" StretchDirection="DownOnly" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- 引用 (本文に付随する画像類より後ろに置く) -->
                                    <Border BorderBrush="#CFD9DE" BorderThickness="1" CornerRadius="8"
                                            Padding="8" Margin="0,6,0,0"
                                            Visibility="{Binding HasQuote, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <!-- 引用先ユーザーアイコン -->
                                                <Grid Width="20" Height="20" Margin="0,0,6,0"
                                                      VerticalAlignment="Center">
                                                    <Ellipse Fill="#D0D7DC" />
                                                    <Image behaviors:ImagePathBehavior.Path="{Binding QuotedIconPath}"
                                                           behaviors:ImagePathBehavior.DecodeWidth="48"
                                                           Stretch="UniformToFill">
                                                        <Image.Clip>
                                                            <EllipseGeometry Center="10,10" RadiusX="10" RadiusY="10" />
                                                        </Image.Clip>
                                                    </Image>
                                                </Grid>
                                                <emoji:TextBlock Text="{Binding QuotedHeader}" FontSize="12"
                                                                 FontWeight="SemiBold" Foreground="#555"
                                                                 VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock behaviors:LinkifiedTextBehavior.Text="{Binding QuotedText}"
                                                       TextWrapping="Wrap" FontSize="13" Margin="0,2,0,0" />
                                            <!-- 引用先の画像 (本文より小さめ) -->
                                            <ItemsControl ItemsSource="{Binding QuotedImagePaths}" Margin="0,6,0,0"
                                                          Visibility="{Binding HasQuotedImages, Converter={StaticResource BoolToVis}}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border CornerRadius="8" Margin="0,0,6,6" MaxHeight="180"
                                                                MaxWidth="260" Background="#F0F0F0">
                                                            <Image behaviors:ImagePathBehavior.Path="{Binding}"
                                                                   behaviors:ImagePathBehavior.DecodeWidth="260"
                                                                   Stretch="Uniform" StretchDirection="DownOnly" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <!-- 引用先本文の動画リンクのサムネイル -->
                                            <ItemsControl ItemsSource="{Binding QuotedLinkThumbnails}" Margin="0,6,0,0"
                                                          Visibility="{Binding HasQuotedLinkThumbnails, Converter={StaticResource BoolToVis}}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:LinkThumbnailViewModel}">
                                                        <Border CornerRadius="8" Margin="0,0,6,6" MaxHeight="135"
                                                                MaxWidth="240" Background="#F0F0F0" Cursor="Hand"
                                                                ToolTip="{Binding PageUrl}"
                                                                MouseLeftButtonUp="LinkThumbnail_Click"
                                                                Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}">
                                                            <Image behaviors:ImagePathBehavior.Path="{Binding ThumbnailPath}"
                                                                   behaviors:ImagePathBehavior.DecodeWidth="240"
                                                                   Stretch="Uniform" StretchDirection="DownOnly" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- カウント -->
                                    <TextBlock Text="{Binding CountsText}" Foreground="#888" FontSize="12"
                                               Margin="0,6,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsRead}" Value="True">
                                <Setter TargetName="UnreadBar" Property="Background" Value="Transparent" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- メディアグリッド (3列正方形サムネイル、行単位で仮想化) -->
            <ListBox x:Name="MediaList"
                     DataContext="{Binding MediaGrid}"
                     ItemsSource="{Binding Rows}"
                     Visibility="{Binding DataContext.IsMediaView,
                         RelativeSource={RelativeSource AncestorType=Window},
                         Converter={StaticResource BoolToVis}}"
                     BorderThickness="0"
                     HorizontalContentAlignment="Stretch"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     ScrollViewer.CanContentScroll="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <b:Interaction.Behaviors>
                    <behaviors:ScrollToTopOnResetBehavior />
                    <behaviors:InfiniteScrollBehavior LoadMoreCommand="{Binding LoadMoreCommand}" />
                </b:Interaction.Behaviors>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Focusable" Value="False" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:MediaRowViewModel}">
                        <ItemsControl ItemsSource="{Binding Cells}"
                                      Height="{Binding ActualWidth,
                                          RelativeSource={RelativeSource AncestorType=ListBox},
                                          Converter={StaticResource Divide}, ConverterParameter=3}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:MediaItemViewModel}">
                                    <Border Margin="1" Background="#ECECEC" ClipToBounds="True"
                                            Cursor="Hand" MouseLeftButtonUp="MediaCell_Click">
                                        <Image behaviors:ImagePathBehavior.Path="{Binding LocalPath}"
                                               behaviors:ImagePathBehavior.DecodeWidth="240"
                                               Stretch="UniformToFill" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            </Grid>
        </DockPanel>

        <!-- ステータスバー -->
        <StatusBar Grid.Row="1" Grid.ColumnSpan="3">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
