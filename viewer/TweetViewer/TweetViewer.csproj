<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- アプリ名は Subako (docs/release-plan.md §0-1)。exe 名だけ変え、
         名前空間・フォルダ名は churn を避けて TweetViewer のまま据え置く -->
    <AssemblyName>Subako</AssemblyName>
    <RootNamespace>TweetViewer</RootNamespace>
    <!-- アイコンの元データは tools/icongen (再実行で同じ .ico を生成できる) -->
    <ApplicationIcon>subako.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.1.1</Version>
    <Product>Subako</Product>
    <Authors>Lichten</Authors>
    <Copyright>© 2026 Lichten</Copyright>
    <Description>X (Twitter) のユーザー単位アーカイブをローカルに保存・閲覧するビューア</Description>
  </PropertyGroup>

  <!-- 公開ビルドに fetcher 一式とライセンス表記を同梱する (docs/release-plan.md §2-1, §4-1)。
       exe と同じフォルダに main.py + sorsa_fetcher/ があれば起動時の自動検出が効く。
       __pycache__ を拾わないよう *.py だけをコピーする -->
  <Target Name="BundleFetcherAndNotices" AfterTargets="Publish">
    <ItemGroup>
      <RootFiles Include="$(MSBuildProjectDirectory)\..\..\main.py" />
      <RootFiles Include="$(MSBuildProjectDirectory)\..\..\requirements.txt" />
      <RootFiles Include="$(MSBuildProjectDirectory)\..\..\.env.example" />
      <RootFiles Include="$(MSBuildProjectDirectory)\..\..\LICENSE" />
      <RootFiles Include="$(MSBuildProjectDirectory)\..\..\THIRD-PARTY-NOTICES.md" />
      <FetcherSources Include="$(MSBuildProjectDirectory)\..\..\sorsa_fetcher\**\*.py" />
    </ItemGroup>
    <Copy SourceFiles="@(RootFiles)" DestinationFolder="$(PublishDir)" />
    <Copy SourceFiles="@(FetcherSources)" DestinationFolder="$(PublishDir)sorsa_fetcher\%(RecursiveDir)" />
  </Target>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Emoji.Wpf" Version="0.3.4" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.142" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.2" />
  </ItemGroup>

</Project>
